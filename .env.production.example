# Copia a .env en el VPS (cp .env.production.example .env) y completa TODOS los valores. No lo subas a git.
# En producción la app NO arranca sin SECRET_KEY. No definas DEMO_PASSWORD (no se crean usuarios de ejemplo).
FLASK_APP=wsgi.py
FLASK_ENV=production
# Genera: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dominio público (sin https://) y correo para avisos de Let's Encrypt
DOMAIN=
LETSENCRYPT_EMAIL=

# Base de datos (la URL se arma sola en docker-compose.prod.yml)
POSTGRES_USER=campo
POSTGRES_PASSWORD=
POSTGRES_DB=campo

# Administrador inicial (se crea al primer arranque). Define los dos o ninguno; luego cambia la clave desde la app.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Sitio y contacto (pie de página y páginas legales)
SITE_NAME=Campo Directo
SITE_REGION=Vélez, Santander, Colombia
CONTACT_EMAIL=
CONTACT_WHATSAPP=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
LEGAL_VERSION=2026-10-borrador

# Mapa: centro por defecto
MAP_CENTER_LAT=6.0139
MAP_CENTER_LNG=-73.6736

# Avisos: in_app (siempre) y, cuando se integren, whatsapp / email
NOTIFICATION_CHANNELS=in_app

# Correo saliente: lleva los códigos para verificar el correo y recuperar la contraseña.
# OBLIGATORIO configurarlo: con MAIL_BACKEND=console NO se envía nada y esas funciones no sirven.
# Opciones baratas o gratis: una cuenta de Gmail con «contraseña de aplicación», Brevo, Mailjet o Zoho.
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Campo Directo <no-responder@tudominio.com>

# Reglas del negocio y límites (opcionales: estos son los valores por defecto)
LISTING_DURATION_DAYS=30
EXPIRING_SOON_DAYS=5
PER_PAGE=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=20 per minute
REGISTER_RATE_LIMIT=10 per hour

# Copias de seguridad
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

LOG_LEVEL=INFO
