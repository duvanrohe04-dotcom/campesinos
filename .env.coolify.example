# Variables de entorno para Coolify. Con el Build Pack «Docker Compose» (docker-compose.coolify.yml) NO hace falta pegar esto:
# Coolify las lista solo en «Environment Variables» y solo debes completar las vacías. Este archivo sirve de referencia
# (y para el Build Pack «Dockerfile»: aplicación → Environment Variables → «Developer view» → pegar y completar).
# NO subas este archivo con valores reales a GitHub.

FLASK_ENV=production
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"   (con Docker Compose la genera Coolify)
SECRET_KEY=

# Base de datos: NO definas DATABASE_URL. Sin ella la app usa SQLite en /srv/instance/campo.db.
# Monta un volumen persistente en /srv/instance, o perderás la base en cada despliegue.
SQLITE_WAL=true
# Copias diarias de la base (en instance/backups): cuántos días se conservan
BACKUP_RETENTION_DAYS=14

# Administrador inicial (se crea al primer arranque). Usa una clave larga; luego puedes cambiarla desde la app.
# ADMIN_PHONE es el usuario para ingresar: una palabra (máx. 10 letras) o un celular de 10 dígitos. Tú eliges el valor.
# ADMIN_PASSWORD: elige una clave larga; luego cámbiala desde la app (Mi perfil → Cambiar mi contraseña).
ADMIN_PHONE=
ADMIN_PASSWORD=

# Correo saliente: sin esto NO llegan los códigos de verificación ni de «olvidé mi contraseña».
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Campo Directo <no-responder@tudominio.com>

# Sitio y contacto (pie de página y páginas legales)
SITE_NAME=Campo Directo
SITE_REGION=Vélez, Santander, Colombia
CONTACT_EMAIL=
CONTACT_WHATSAPP=
LEGAL_VERSION=2026-10-borrador

# Tareas programadas (vencer anuncios, alertas, precios, copia de la base) dentro del mismo contenedor.
# Déjalo en true con 1 sola réplica (con SQLite siempre debe haber una sola).
RUN_SCHEDULER=true

# Procesos web. 2 alcanza para un servidor pequeño.
WEB_CONCURRENCY=2

# Registros a la consola de Coolify (no a un archivo dentro del contenedor)
LOG_TO_FILE=false
LOG_LEVEL=INFO

# Límites de velocidad: 'memory://' funciona, pero cada proceso cuenta aparte.
RATELIMIT_STORAGE_URI=memory://
