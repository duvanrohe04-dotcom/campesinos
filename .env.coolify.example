# Variables de entorno para Coolify (aplicación → Environment Variables → «Developer view» → pega todo y completa).
# NO subas este archivo con valores reales a GitHub: aquí solo van los nombres y ejemplos.

FLASK_ENV=production
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Pega aquí la «Postgres URL (internal)» que muestra Coolify en tu base de datos PostgreSQL.
DATABASE_URL=

# Administrador inicial (se crea al primer arranque). Usa una clave larga; luego puedes cambiarla desde la app.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Correo saliente: sin esto NO llegan los códigos de verificación ni de «olvidé mi contraseña».
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Campo Directo <no-responder@tudominio.com>

# Sitio y contacto (pie de página y páginas legales)
SITE_NAME=Campo Directo
SITE_REGION=Vélez, Santander, Colombia
CONTACT_EMAIL=
CONTACT_WHATSAPP=
LEGAL_VERSION=2026-10-borrador

# Tareas programadas (vencer anuncios, alertas, precios) dentro del mismo contenedor. Déjalo en true con 1 sola réplica.
RUN_SCHEDULER=true

# Procesos web. 2 alcanza para un servidor pequeño; 3 si tiene memoria de sobra.
WEB_CONCURRENCY=2

# Registros a la consola de Coolify (no a un archivo dentro del contenedor)
LOG_TO_FILE=false
LOG_LEVEL=INFO

# Límites de velocidad: 'memory://' funciona, pero cada proceso cuenta aparte. Si agregas un Redis en Coolify,
# pon aquí su URL interna (redis://...) y los límites se comparten.
RATELIMIT_STORAGE_URI=memory://
