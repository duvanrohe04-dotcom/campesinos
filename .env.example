# Copia este archivo a .env y ajusta los valores. NO hagas commit de .env
# (las variables vacías usan el valor por defecto de app/config.py).

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development                 # development | production
# Genera: python -c "import secrets; print(secrets.token_hex(32))"
# En desarrollo, si la dejas vacía se genera una al iniciar (las sesiones se cierran al reiniciar).
SECRET_KEY=
PORT=5000

# --- Base de datos ---
# Vacío = SQLite en instance/campo.db. Para PostgreSQL: postgresql://usuario:clave@host:5432/base
DATABASE_URL=
# Solo para docker compose (la URL se arma sola)
POSTGRES_USER=campo
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_FUERTE
POSTGRES_DB=campo

# --- Cuentas iniciales (flask seed) ---
ADMIN_PHONE=
ADMIN_PASSWORD=
# Clave de los usuarios de EJEMPLO (`flask seed` sin --sin-ejemplos). Solo desarrollo; nunca en producción.
DEMO_PASSWORD=

# --- Sitio y contacto (pie de página, páginas legales y SEO) ---
SITE_NAME=Campo Directo
SITE_REGION=Vélez, Santander, Colombia
CONTACT_EMAIL=contacto@tudominio.com
CONTACT_WHATSAPP=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
LEGAL_VERSION=2026-10-borrador

# --- Mapa: centro por defecto ---
MAP_CENTER_LAT=6.0139
MAP_CENTER_LNG=-73.6736

# --- Avisos y verificación ---
NOTIFICATION_CHANNELS=in_app          # in_app,whatsapp,email

# --- Correo saliente (códigos para verificar el correo y recuperar la contraseña) ---
# console = en desarrollo el correo se imprime en la terminal; smtp = envío real (ver .env.production.example)
MAIL_BACKEND=console
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=Campo Directo <no-responder@tudominio.com>

# --- Reglas del negocio ---
LISTING_DURATION_DAYS=30
EXPIRING_SOON_DAYS=5
PER_PAGE=12
MAX_IMAGES=6
MAX_IMAGE_BYTES=10485760
MAX_CONTENT_LENGTH=41943040
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Límite de peticiones por IP ---
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=20 per minute
REGISTER_RATE_LIMIT=10 per hour
REPORT_RATE_LIMIT=10 per hour
CONTACT_RATE_LIMIT=10 per hour
VERIFY_RATE_LIMIT=10 per hour
POSTER_RATE_LIMIT=60 per hour
PUBLISH_RATE_LIMIT=20 per hour
CONTACT_REVEAL_RATE_LIMIT=40 per hour   # «Ver celular» y botón de WhatsApp (frena a quien recolecta números)
ACCOUNT_RATE_LIMIT=10 per hour          # descargar o eliminar la cuenta

# --- Anti-spam al publicar ---
MAX_ACTIVE_LISTINGS=40                  # anuncios activos por persona
NEW_ACCOUNT_HOURS=24                    # una cuenta es «nueva» durante estas horas...
NEW_ACCOUNT_MAX_LISTINGS=5              # ...y puede tener este máximo de anuncios activos
RATING_RATE_LIMIT=20 per hour

# --- Logs y archivos ---
LOG_LEVEL=INFO
LOG_TO_FILE=false
UPLOAD_FOLDER=
TZ=America/Bogota
